{
    "name": "avillatoro",
    "version": "0.5.0",
    "private": true,
    "description": "MMORPG 2D estilo Tibia con arquitectura de servidor de Tibia: motor, cliente, herramientas y datapack extensible por modulos JavaScript y definiciones XML.",
    "license": "MPL-2.0",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "engine": "node engine/main.js",
        "engine:reload": "node engine/main.js --reload",
        "test": "node tools/test-engine.js && node tools/test-world.js && node tools/test-simulation.js",
        "test:engine": "node tools/test-engine.js",
        "test:world": "node tools/test-world.js",
        "test:simulation": "node tools/test-simulation.js",
        "start": "node server/js/main.js",
        "test:legacy": "node tools/smoke-test.js",
        "check:client": "node tools/check-client.js",
        "check:world": "node tools/diag-world.js",
        "check:globals": "node tools/audit-globals.js"
    },
    "dependencies": {
        "fast-xml-parser": "^5.11.2",
        "underscore": "^1.13.8",
        "ws": "^8.22.0"
    }
}
