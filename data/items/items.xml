<!--
    Definiciones de items.

    Las BANDERAS son lo que hace funcionar el apilado y las reglas de paso, así
    que conviene saber de dónde salen. En The Forgotten Server las banderas
    binarias viven en `items.otb` (`FLAG_BLOCK_SOLID`, `FLAG_ALWAYSONTOP`...), y
    este XML sólo aporta lo semántico. Aquí todavía no hay importador de OTB, así
    que las banderas se declaran como atributos del XML. Cuando llegue el
    importador, este archivo recuperará su papel real: completar, no definir.

    Dos nombres que se usan aquí y conviene no confundir:

      isGround      el suelo del tile. Hay uno por tile y siempre va abajo.
      alwaysOnTop   se dibuja ENCIMA de las criaturas (mesas, barandillas,
                    tejados). Equivale a FLAG_ALWAYSONTOP de Tibia, que pese al
                    nombre significa "siempre en la banda de arriba": el código de
                    Remere's Map Editor lo comenta literalmente diciendo que es
                    confuso y que hay que aceptarlo. Aquí no se hereda el nombre.

    Y las banderas de bloqueo, que son tres y NO son lo mismo:

      blocksSolid       impide caminar por el tile
      blocksProjectile  impide el paso de flechas y runas
      blocksPathfind    impide que el cálculo de rutas lo atraviese
-->
<items>

	<!-- ===================== Suelos ===================== -->

	<item id="102" name="grass">
		<attribute key="isGround" value="1" />
		<attribute key="groundSpeed" value="150" />
	</item>

	<item id="103" name="dirt">
		<attribute key="isGround" value="1" />
		<attribute key="groundSpeed" value="150" />
	</item>

	<item id="104" name="stone floor">
		<attribute key="isGround" value="1" />
		<attribute key="groundSpeed" value="150" />
	</item>

	<!-- Un suelo mas lento, para poder probar el coste de paso por terreno. -->
	<item id="105" name="shallow water">
		<attribute key="isGround" value="1" />
		<attribute key="groundSpeed" value="300" />
	</item>

	<!-- ===================== Obstaculos ===================== -->

	<item id="111" article="a" name="stone wall">
		<attribute key="blocksSolid" value="1" />
		<attribute key="blocksProjectile" value="1" />
		<attribute key="blocksPathfind" value="1" />
	</item>

	<!-- Va encima de las criaturas pero NO bloquea: sirve para ver la diferencia
	     entre pertenecer a la banda de arriba e impedir el paso. -->
	<item id="112" article="a" name="wooden railing">
		<attribute key="alwaysOnTop" value="1" />
	</item>

	<item id="113" article="a" name="table">
		<attribute key="alwaysOnTop" value="1" />
		<attribute key="blocksSolid" value="1" />
		<attribute key="blocksPathfind" value="1" />
	</item>

	<!-- ===================== Objetos usables ===================== -->

	<item id="1948" article="a" name="lever">
		<attribute key="useable" value="1" />
	</item>

	<item id="1387" article="a" name="teleport" />

