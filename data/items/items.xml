	<item id="3031" article="a" name="gold coin" plural="gold coins">
		<attribute key="weight" value="10" />
		<attribute key="pickupable" value="1" />
		<attribute key="stackable" value="1" />
	</item>

	<item id="2160" article="a" name="crystal coin" plural="crystal coins">
		<attribute key="weight" value="10" />
		<attribute key="pickupable" value="1" />
		<attribute key="stackable" value="1" />
	</item>

	<item id="2400" article="a" name="magic sword">
		<attribute key="weight" value="4200" />
		<attribute key="attack" value="48" />
		<attribute key="defense" value="35" />
		<attribute key="weaponType" value="sword" />
		<attribute key="slotType" value="hand" />
